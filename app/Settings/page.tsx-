"use client"
import Link from "next/link"

export default function SettingsPage(){
  const Item = ({icon, title, on}:{icon:any, title:string, on?:()=>void}) => (
    <button onClick={on} className="w-full flex justify-between items-center p-4 hover:bg-zinc-50 active:bg-zinc-100">
      <div className="flex items-center gap-4">
        <div className="w-6 h-6 flex items-center justify-center">{icon}</div>
        <span className="text-[16px]">{title}</span>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" strokeWidth="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  )

  return(
    <div className="max-w-[470px] mx-auto bg-white min-h-screen text-black">
      {/* HEADER */}
      <div className="flex items-center gap-4 p-4">
        <Link href="/profile"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></Link>
        <h1 className="font-bold text-[20px]">Settings and activity</h1>
      </div>

      {/* SEARCH */}
      <div className="px-3 pb-3">
        <div className="bg-[#efefef] rounded-lg px-3 py-2.5 flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8e8e8e" strokeWidth="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input placeholder="Search" className="bg-transparent outline-none text-[15px] w-full placeholder:text-[#8e8e8e]"/>
        </div>
      </div>

      {/* YOUR ACCOUNT */}
      <div className="p-4 border-b border-zinc-100">
        <div className="flex justify-between items-center mb-1">
          <h3 className="font-bold text-[15px] text-[#8e8e8e]">Your account</h3>
          <span className="font-bold text-[15px] flex items-center gap-1"><span className="text-[18px]">∞</span> Meta</span>
        </div>

        <Link href="#" className="flex justify-between items-start mt-4">
          <div className="flex gap-3">
            <div className="w-7 h-7 rounded-full border-[1.5px] border-black flex items-center justify-center mt-1">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div className="pr-6">
              <p className="font-normal text-[16px] leading-tight">Accounts Centre</p>
              <p className="text-[#8e8e8e] text-[13px] leading-tight mt-1">Password, security, personal details, ad preferences</p>
            </div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" strokeWidth="2" className="mt-1"><polyline points="9 18 15 12 9 6"/></svg>
        </Link>

        <p className="text-[#8e8e8e] text-[13px] mt-4 leading-[18px]">Manage your connected experiences and account settings across Meta technologies. <span className="text-[#0095f6]">Learn more</span></p>
      </div>

      {/* HOW YOU USE INSTAGRAM */}
      <div className="border-t-[8px] border-[#f5f5f5]">
        <h3 className="p-4 pb-2 font-bold text-[15px] text-[#8e8e8e]">How you use Instagram</h3>

        <Item title="Saved" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>} />

        <Item title="Archive" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 16 12 12 8 10"/><path d="M16 8h-3"/><path d="M16 5l-3 3 3"/></svg>} />

        <Item title="Your activity" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>} />

        <Item title="Notifications" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><path d="M18 8A6 6 0 0 0 6 8c0 7-6 9-6 9h18s-6-2-6-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>} />

        <Item title="Time management" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>} />

        <Item title="Instagram for tablets" icon={<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="1.8"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>} />
